# Copy to web/.env (git-ignored) and fill in from Supabase: Project Settings -> API.
# Only the public anon key belongs here. NEVER put the service_role key in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. Staff IDs are mapped to <id>@<domain>; must equal STAFF_EMAIL_DOMAIN of the admin-staff function.
# VITE_STAFF_EMAIL_DOMAIN=company.demo

# Optional branding (provisional defaults shown). The Android package id is used from the Android phase.
# VITE_BRAND_NAME=CosmiConnect
# VITE_BRAND_COMPANY=CosmiChameleon
# VITE_BRAND_PACKAGE_ID=io.cosmichameleon.cosmiconnect
# VITE_BRAND_TAGLINE=Business messaging for your team
# VITE_BRAND_ACCENT=
# VITE_BRAND_CHARCOAL=

# Development builds only: show "Set token (dev)" in the admin console (the server also needs ALLOW_MANUAL_TOKEN=true).
# VITE_ENABLE_MANUAL_TOKEN=true
