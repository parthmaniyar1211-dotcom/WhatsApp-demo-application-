# Secrets for running the Edge Functions LOCALLY (`supabase start` / `supabase functions serve`).
# Copy to supabase/functions/.env (git-ignored). For the hosted project use `supabase secrets set` instead.
# These are throwaway local values, not your real Meta credentials.
WA_VERIFY_TOKEN=local-verify-token
WA_APP_SECRET=local-app-secret
WA_PHONE_ID=LOCAL_PHONE_ID
WA_DRY_RUN=true

# Multi-tenant switches. BOTH default to off; leave them off on any project that serves real clients.
# Lets an admin store a connection token by hand (development only; tokens normally come from Embedded Signup).
# ALLOW_MANUAL_TOKEN=true
# Embedded Signup onboarding. Stays off until Meta Tech Provider approval is confirmed.
# FEATURE_EMBEDDED_SIGNUP=true
