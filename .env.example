# Settings for the test harness (scripts/) and the Playwright end-to-end test.
# Copy to .env (git-ignored). The Supabase URL and anon key are read from web/.env.
#
# WA_APP_SECRET / WA_VERIFY_TOKEN must be the same values you stored with
# `supabase secrets set`. They stay on your machine; never commit them.

# Optional: only if the webhook is not at <VITE_SUPABASE_URL>/functions/v1/whatsapp-webhook
# WEBHOOK_URL=

WA_APP_SECRET=
WA_VERIFY_TOKEN=
# Must match WA_PHONE_ID on the server, otherwise simulated events are ignored.
WA_PHONE_ID=

# A staff login used by simulate-duplicate (row count) and by the Playwright test.
E2E_STAFF_ID=EMP1001
E2E_PASSWORD=

# Optional: an admin login, enables the admin-page Playwright test.
E2E_ADMIN_ID=
E2E_ADMIN_PASSWORD=

# Optional: simulated customer
# SIM_FROM=919800000001
# SIM_NAME=Test Customer

# `npm run real-check` additionally needs your real WA_TOKEN (and optionally
# WA_BUSINESS_ACCOUNT_ID). Do not put them here: it reads ~/wa-secrets.env by itself.
